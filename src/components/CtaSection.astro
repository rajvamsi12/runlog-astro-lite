---
import { site } from '../data/site';
import Section from './Section.astro';
interface Props { title?: string; lede?: string }
const { title = "Let's talk safe autonomy.", lede = 'Looking for PhD positions starting Fall 2027 in autonomous robotics, safe RL, imitation learning and learning-based control.' } = Astro.props;
---

<Section id="contact" mode="invert" inner="px-6 py-32 max-md:px-5 max-md:py-24 text-center overflow-hidden" label="Contact">
  <div class="grid-bg" style="--gx:50%;--gy:45%" aria-hidden="true"></div>
  <svg class="absolute inset-0 m-auto pointer-events-none max-md:scale-75" width="760" height="760" viewBox="0 0 760 760" fill="none" aria-hidden="true">
    <circle cx="380" cy="380" r="259.5" stroke="var(--stone)" />
    <circle cx="380" cy="380" r="379.5" stroke="var(--rule)" stroke-dasharray="3 5" />
    <rect x="630" y="324" width="8" height="8" fill="var(--cta)" />
    <rect x="76" y="608" width="8" height="8" fill="var(--cta)" />
  </svg>
  <div class="relative">
    <p class="label"><b>[10]</b> contact</p>
    <h2 class="mt-5 text-[clamp(40px,6vw,72px)] leading-none font-bold tracking-[-0.05em]">{title}</h2>
    <p class="mt-5 mx-auto max-w-[56ch] text-[16px] text-steel max-md:text-[14px]">{lede}</p>
    <div class="mt-9 flex flex-wrap justify-center items-center gap-x-7 gap-y-4 max-md:flex-col max-md:items-stretch">
      <a href={`mailto:${site.email}`} class="btn btn-primary">Email me -&gt;</a>
      <a href={site.cta.href} class="link text-[15px]">Download CV -&gt;</a>
      <a href={site.github} class="link text-[15px]">GitHub -&gt;</a>
      <a href={site.linkedin} class="link text-[15px]">LinkedIn -&gt;</a>
    </div>
    <p class="mt-12 inline-flex max-w-full items-center gap-2.5 border border-rule bg-tint px-4 py-3 text-[13px] text-ink">
      <span class="truncate">$ mail {site.email}</span> <span class="size-1.5 shrink-0 rounded-full bg-ok" aria-hidden="true"></span><span class="text-steel shrink-0">open</span>
    </p>
  </div>
</Section>
