---
// Monochrome code on purpose: weight and gray carry the syntax, color stays reserved for actions.
const c = (s: string) => `<span class="text-smoke">${s}</span>`;
const k = (s: string) => `<b class="text-ink font-semibold">${s}</b>`;

const tabs = [
  {
    id: 'filter',
    label: 'safety_filter',
    code: `${c('# simplified sketch of the Neural ICBF safety filter (one control step)')}
${k('def')} safe_action(x):
    u_ref = policy(x)                    ${c('# imitation-learned from an NMPC')}
    h, dh = barrier(x), grad(barrier)(x)  ${c('# learned barrier, autodiff')}
    f, g  = neural_ode.drift(x), neural_ode.input(x)
    ${k('return')} qp(
        minimize = norm(u - u_ref),
        subject_to = [
            dh @ (f + g @ u) >= -alpha(h),  ${c('# stay in the safe set')}
            u_min <= u <= u_max,            ${c('# input constraints')}
            tire_grip(x, u) <= mu,          ${c('# racing extension')}
        ],
    )`,
  },
  {
    id: 'labels',
    label: 'labeling',
    code: `${c('# forward-invariance-aware labels: a state is only "safe"')}
${c('# if some admissible input keeps it safe as it evolves')}
${k('def')} label(x0):
    ${k('if not')} geometrically_safe(x0):
        ${k('return')} UNSAFE
    ${k('for')} maneuver ${k('in')} escape_set:      ${c('# 22 maneuvers on F1TENTH')}
        traj = rollout(x0, maneuver, u_limits)
        ${k('if')} all(geometrically_safe(x) ${k('for')} x ${k('in')} traj):
            ${k('return')} SAFE
    ${k('return')} UNSAFE                       ${c('# 28.95% of samples relabeled')}`,
  },
  {
    id: 'real2sim',
    label: 'real2sim',
    code: `${c('# Gwalior traffic -> CARLA Town10HD, then screen for collisions')}
${k('for')} scene ${k('in')} candidates:                 ${c('# 26,868 candidates')}
    tracks = calibrate(scene, regions=6)   ${c('# left-hand traffic, per-region map')}
    actors = spawn_road_aligned(tracks, size_matched_blueprints)
    ${k('if')} offline_collision_predictor(actors):
        actors = separate_trajectories(actors)  ${c('# recovered 653')}
    replay(actors, controller=synced_pid)  ${c('# tracking error < 0.3 m')}`,
  },
];
---

<div class="code-tabs border border-rule bg-canvas" data-tabs>
  <div class="flex border-b border-rule text-[13px]" role="tablist" aria-label="Method sketches">
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${t.id}`}
        aria-controls={`panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        class="tab px-4 h-11 border-r border-rule text-smoke hover:text-ink"
      >{t.label}</button>
    ))}
    <span class="ml-auto self-center pr-4 text-[12px] text-smoke hidden sm:inline">sketch.py</span>
  </div>
  {tabs.map((t, i) => (
    <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
      <pre class="p-5 sm:p-6 overflow-x-auto text-[13px] leading-[1.7] text-steel"><code set:html={t.code} /></pre>
    </div>
  ))}
</div>

<style>
  .tab[aria-selected='true'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--ink); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });
</script>
