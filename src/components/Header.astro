---
import { site } from '../data/site';
import ThemeSwitcher from './ThemeSwitcher.astro';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---

<header class="border-b border-rule bg-canvas">
  <nav class="mx-auto max-w-[680px] flex items-center gap-6 h-14 px-5" aria-label="Main">
    <Logo />
    <ul class="ml-auto flex gap-5 text-[13px]">
      {site.nav.map((l) => (
        <li><a href={l.href} class:list={['hover:text-ink', path.startsWith(l.href) && l.href !== '/' ? 'text-ink' : 'text-steel']}>{l.label}</a></li>
      ))}
    </ul>
    <div class="max-sm:hidden"><ThemeSwitcher /></div>
  </nav>
</header>
