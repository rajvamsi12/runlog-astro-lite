---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const experience = [
  {
    when: '2026 - now',
    title: 'Research Intern, University of Virginia',
    body: 'Neural integral control barrier functions for safe control of unknown nonlinear systems. Extended the method to an F1TENTH racing model.',
    link: 'https://github.com/rajvamsi12/agile-nicbf',
  },
  {
    when: '2025 - now',
    title: 'M.Tech Thesis, ABV-IIITM Gwalior',
    body: 'Real-to-sim trajectory style transfer: replaying Gwalior traffic in CARLA. Advised by Dr. Rahul Kala.',
    link: 'https://github.com/rajvamsi12/real2sim-trajectory-style-transfer',
  },
  {
    when: '2024 - 2025',
    title: 'Research Intern, iHub-Data, IIIT Hyderabad',
    body: 'Safety-aware synthetic scenario generation for Indian traffic and behavior cloning in CARLA.',
  },
];

const papers = [
  ['While in London do as the Gwaliorites do: Style Transfer of Trajectories across Traffic Domains in Real-to-Sim', 'Under review, WAFR 2026'],
  ['GLAD-LAD: Gwalior LAneless Driving Large Altitude Dataset', 'Under review, Transportation Research Part C'],
];
---

<Base>
  <div class="mx-auto max-w-[680px] px-5 pt-20 pb-24 max-md:pt-12">
    <h1 class="text-[32px] max-md:text-[26px] font-bold tracking-[-0.03em] text-ink">Dasari Raj Vamsi</h1>
    <div class="mt-6 space-y-4 text-[15px] leading-[1.7] text-steel">
      <p>I'm an Integrated B.Tech + M.Tech student in Information Technology at ABV-IIITM Gwalior, currently a research intern at the University of Virginia.</p>
      <p>I'm interested in how autonomous systems can act safely in situations they weren't trained for. Most of my work combines learning-based control with safety methods like control barrier functions, and tests it in simulation.</p>
      <p>I'm applying for PhD programs starting Fall 2027.</p>
    </div>
    <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[14px]">
      <a href={`mailto:${site.email}`} class="link">Email</a>
      <a href={site.github} class="link">GitHub</a>
      <a href={site.linkedin} class="link">LinkedIn</a>
      <a href={site.cta.href} class="link">CV</a>
    </p>

    <h2 id="research" class="mt-16 text-[13px] uppercase tracking-[0.08em] text-smoke">Research</h2>
    <ul class="mt-5 space-y-7">
      {experience.map((e) => (
        <li>
          <p class="flex flex-wrap items-baseline justify-between gap-x-4">
            <span class="text-[15px] font-bold text-ink">{e.title}</span>
            <span class="text-[13px] text-smoke tabular-nums">{e.when}</span>
          </p>
          <p class="mt-1.5 text-[14px] leading-[1.65] text-steel">
            {e.body}
            {e.link && <> <a href={e.link} class="link">Code</a></>}
          </p>
        </li>
      ))}
    </ul>

    <h2 id="publications" class="mt-16 text-[13px] uppercase tracking-[0.08em] text-smoke">Publications</h2>
    <ul class="mt-5 space-y-5">
      {papers.map(([t, v]) => (
        <li>
          <p class="text-[14px] leading-[1.55] text-ink">{t}</p>
          <p class="mt-1 text-[13px] text-smoke">{v}</p>
        </li>
      ))}
    </ul>

    <h2 class="mt-16 text-[13px] uppercase tracking-[0.08em] text-smoke">Education</h2>
    <p class="mt-5 flex flex-wrap items-baseline justify-between gap-x-4">
      <span class="text-[15px] font-bold text-ink">ABV-IIITM Gwalior</span>
      <span class="text-[13px] text-smoke tabular-nums">2022 - 2027</span>
    </p>
    <p class="mt-1.5 text-[14px] text-steel">Integrated B.Tech + M.Tech, Information Technology. CGPA 8.73/10.</p>

    <h2 class="mt-16 text-[13px] uppercase tracking-[0.08em] text-smoke">Writing</h2>
    <p class="mt-5 text-[14px]"><a href="/blog/research-statement" class="link">Research statement</a></p>
  </div>
</Base>
