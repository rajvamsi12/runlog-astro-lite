---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Writing" description="Writing by Dasari Raj Vamsi.">
  <div class="mx-auto max-w-[680px] px-5 pt-20 pb-24 max-md:pt-12">
    <h1 class="text-[32px] max-md:text-[26px] font-bold tracking-[-0.03em] text-ink">Writing</h1>
    <ul class="mt-10 space-y-5">
      {posts.map((p) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-4">
          <a href={`/blog/${p.id}`} class="link text-[15px]">{p.data.title}</a>
          <time class="text-[13px] text-smoke" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        </li>
      ))}
    </ul>
  </div>
</Base>
