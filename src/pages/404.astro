---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <Section top={false} inner="px-5 pt-20 pb-24 max-md:pt-12"><div class="mx-auto max-w-[680px]">
    <h1 class="text-[32px] font-bold tracking-[-0.03em] text-ink">404</h1>
    <p class="mt-4 text-[15px] text-steel">This page does not exist. <a href="/" class="link">Go home</a></p>
  </div></Section>
</Base>
